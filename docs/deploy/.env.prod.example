# 生产配置模板。复制到 backend/.env（**不是这个目录**）后逐行改：
#
#     cp deploy/.env.prod.example backend/.env
#     chmod 600 backend/.env          # 里面有数据库密码和后台令牌
#
# 这个文件本身是模板，可以进仓库；改好的 backend/.env 不能（已在 .gitignore 里）。

PLOVE_ENV=prod

# 只监听回环：外面必须经过 nginx。**不要改成 0.0.0.0。**
PLOVE_HOST=127.0.0.1
PLOVE_PORT=8000

PLOVE_LOG_LEVEL=INFO

# 上线后建议关掉（再把 nginx 里那两行 /docs 注释掉）。
# 它不泄露密码，但会把全部接口形状公开，包括后台接口的路径。
PLOVE_DOCS_ENABLED=false

# --------------------------------------------------------------- 数据库
# 库和 API 在同一台机器上，所以走回环。
# **不要把 3306 开到公网** —— 那等于把数据库摆到大街上，
# 而且会招来源源不断的扫描和暴力破解。
#
# 建库建用户见 CHECKLIST 第 4 步。密码自己生成：openssl rand -base64 24
PLOVE_DATABASE_URL=mysql+pymysql://plove:换成你的密码@127.0.0.1:3306/plove?charset=utf8mb4
PLOVE_DATABASE_ECHO=false

# --------------------------------------------------------------- 爬虫
# 默认就是 /opt/plove/crawler（backend 的上一层），保持这个相对位置就不用写
# PLOVE_CRAWLER_DIR=/opt/plove/crawler
#
# ⚠️ 超时是在**开发机**上量出来的（ncat21 home 约 9s / play 约 4~7s）。
# 到了 VPS 上一定要重新量一遍（CHECKLIST 第 2 步会做）：
# 如果这台机器访问源站明显更慢，这两个值要跟着调大。
PLOVE_CRAWLER_TIMEOUT=20.0
PLOVE_CRAWLER_TIMEOUT_PLAY=25.0

# --------------------------------------------------------------- 缓存
PLOVE_CACHE_TTL_HOME=90000.0      # 25 小时：**比预热周期略长**
PLOVE_CACHE_TTL_CATEGORY=90000.0
PLOVE_CACHE_TTL_DETAIL=90000.0
PLOVE_CACHE_MAXSIZE=512
# 说明：TTL 比预热周期长，是为了让缓存"永远由预热来刷新"，
# 而不是等某个普通请求撞上过期、由他来承担那几秒等待。
# 代价是：如果预热因为某种原因停了很久，数据会更旧 —— 所以预热失败要能看见
# （GET /api/v1/admin/status 里有 last_finished_at 和每个源的结果）。

# --------------------------------------------------------------- 稳定性
PLOVE_SITE_MAX_CONCURRENCY=2
PLOVE_GLOBAL_MAX_CONCURRENCY=4
PLOVE_SITE_QUEUE_TIMEOUT=20.0
PLOVE_BREAKER_FAIL_THRESHOLD=5
PLOVE_BREAKER_RESET_SECONDS=60.0

# --------------------------------------------------------------- 主动预热
# 生产**打开**：它让用户永远命中新鲜的缓存，也永远不用等那几秒。
PLOVE_WARMUP_ENABLED=true
PLOVE_WARMUP_INTERVAL_SECONDS=86400.0     # 24 小时
PLOVE_WARMUP_INITIAL_DELAY=60.0          # 启动 60 秒后才开跑，别和第一批请求抢源站
PLOVE_WARMUP_MAX_CATEGORIES=3

# --------------------------------------------------------------- 密钥
# 后台管理令牌。生成：
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# **留空 = 后台接口全部拒绝**（这是故意的：忘配一个变量不该等于后台裸奔）。
PLOVE_ADMIN_TOKEN=换成你生成的那一串

PLOVE_HEARTBEAT_INTERVAL_SECONDS=30

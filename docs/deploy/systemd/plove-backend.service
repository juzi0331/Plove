[Unit]
Description=Plove 后端（FastAPI 网关）
Documentation=file:/opt/plove/deploy/CHECKLIST.md
# 等网络就绪再起（爬虫要联网，冷启动时的预热也要）
After=network-online.target
Wants=network-online.target
# 数据库在这台机器上：保证它先起来
After=mysql.service
Wants=mysql.service

# 反复崩溃时别无限重启把自己淹没：5 分钟内超过 5 次就停下并记日志。
# 注意这两条属于 [Unit] 段，写进 [Service] 会被 systemd 当成未知项忽略。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=plove
Group=plove
WorkingDirectory=/opt/plove/backend

# ⚠️ 不要加 --workers。缓存 / 防击穿 / 熔断 / 预热都是**进程内状态**，
# 多 worker 会让它们各自为政（缓存命中率除以 N、预热跑 N 遍）。
# 理由写在 deploy/README.md。
ExecStart=/opt/plove/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000

# 配置从 .env 读（pydantic-settings 自己也会读，这里显式给一份更直观）。
# 文件权限设成 600，只有 plove 用户能看 —— 里面有数据库密码和后台令牌。
EnvironmentFile=/opt/plove/backend/.env

Restart=always
RestartSec=3

# 停止时给够时间：lifespan 里要把后台预热线程收掉，
# 而它可能正卡在一次源站请求上（最坏几十秒）。
# 用 SIGINT：这是 uvicorn 的"优雅退出"信号，会走 lifespan 的 finally。
KillSignal=SIGINT
TimeoutStopSec=45

# 日志进 journald：journalctl -u plove-backend -f
StandardOutput=journal
StandardError=journal

# 关掉 core dump（core 里可能有配置内容）
LimitCORE=0

# ---- 收窄权限（这台机器只跑这一个服务，能收就收）----
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# ProtectSystem=full 只把 /usr · /boot · /etc 挂成只读，/opt 本来就可写，
# 所以这一条现在其实是冗余的。留着是为了以后有人改成 strict 时不会把服务写死。
ReadWritePaths=/opt/plove/backend

[Install]
WantedBy=multi-user.target

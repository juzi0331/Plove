# 复制成 .env 后按需修改。所有变量都带 PLOVE_ 前缀。
#
# 这是**本地开发**用的模板。
# 上线用的模板在 [../deploy/.env.prod.example](../deploy/.env.prod.example)，
# 那一份的取值不一样（预热打开、TTL 更长、数据库指向回环、/docs 关掉）。

# 运行环境：dev / prod
PLOVE_ENV=dev

# 监听地址（生产由 systemd 指定 --host/--port，这里只是默认值）
PLOVE_HOST=127.0.0.1
PLOVE_PORT=8000

# API 前缀
PLOVE_API_PREFIX=/api/v1

# 日志级别：DEBUG / INFO / WARNING / ERROR
PLOVE_LOG_LEVEL=INFO

# 开发时开着 /docs（Swagger）最方便；上线后建议关掉。
# 它不泄露密码，但会把全部接口形状公开，包括后台接口的路径。
PLOVE_DOCS_ENABLED=true

# 爬虫目录。留空 = 仓库根下的 crawler/
PLOVE_CRAWLER_DIR=

# 契约目录。留空 = 仓库根下的 contracts/
PLOVE_CONTRACTS_DIR=

# 爬虫单次调用超时（秒）。到点直接 kill 子进程，不拖慢在线服务。
#
# 实测（开发机）：ai2048 home/detail/play 各约 1~2s；
#                 ncat21 home 5.2~8.9s、detail 2.9~5.9s、play 4.0~7.2s（波动很大）。
# 早先按 4s 的量配过 10 秒，后来真的超时过一次，所以留到 2 倍以上。
# 别凭感觉调小 —— 那会变成"平时刚好、网络一抖就 504"。
#
# ⚠️ 换到 VPS 上要**重新量一遍**：同一台源站，从机房 IP 访问可能更慢。
PLOVE_CRAWLER_TIMEOUT=20.0
PLOVE_CRAWLER_TIMEOUT_PLAY=25.0

# --------------------------------------------------------------- 缓存
# 目录类内容的缓存生存时间（秒）。**设成 0 就等于关掉这一类缓存。**
#
# 实测效果（真源）：ncat21 首页 8.9s → 0.000s，详情 5.9s → 0.000s。
# 取值依据是"这东西多久会变"，不是"能省多少"。
# 播放地址**永远不缓存**（m3u8 带时效签名），所以这里没有它。
PLOVE_CACHE_TTL_HOME=600.0
PLOVE_CACHE_TTL_CATEGORY=300.0
PLOVE_CACHE_TTL_DETAIL=300.0
# 缓存条数上限（LRU 淘汰）
PLOVE_CACHE_MAXSIZE=512

# --------------------------------------------------------------- 稳定性
# 单个源允许同时在跑的爬虫子进程数（保护**源站**）
PLOVE_SITE_MAX_CONCURRENCY=2
# 全站同时在跑的爬虫子进程数上限（保护**这台机器**）
# 没有它的话，源变多之后总量是乘出来的：10 个源 × 2 = 20 个并发子进程。
PLOVE_GLOBAL_MAX_CONCURRENCY=4
# 抢不到并发槽位时最多排多久（秒），到点明确回 UPSTREAM_BUSY
PLOVE_SITE_QUEUE_TIMEOUT=20.0
# 连续失败多少次就熔断该源（NOT_FOUND / UNSUPPORTED 这类"正确的回答"不计入）
PLOVE_BREAKER_FAIL_THRESHOLD=5
# 熔断后冷却多久（秒），冷却结束放一个探针试探
PLOVE_BREAKER_RESET_SECONDS=60.0

# --------------------------------------------------------------- 主动预热
# 定时主动抓取每个源的"入口页"填进缓存。
#
# 解决 TTL 的固有毛病：TTL 到点后是**下一个来访者**触发重抓、由他承担
# 几秒到十几秒的等待，而且没人来的话数据会一直旧着；重启之后还会冷启动。
#
# **默认关**（它会在没人访问时也去请求源站，属于"默认打开会很意外"的事）。
# 本地开发建议也关着：别让调试时后台一直在请求源站。
PLOVE_WARMUP_ENABLED=false
# 周期（秒）。86400 = 24 小时
PLOVE_WARMUP_INTERVAL_SECONDS=86400.0
# 启动后等多久才开始第一次预热（秒）。别和启动时的第一批请求抢源站。
PLOVE_WARMUP_INITIAL_DELAY=60.0
# 每个源预热几个分类的第一页。别调大：详情页不预热，全热等于定时去爬整个站。
PLOVE_WARMUP_MAX_CATEGORIES=3

# --------------------------------------------------------------- 数据库
# 本地开发默认是 SQLite 文件（clone 下来就能直接跑测试）。
# 真要连 MySQL 就覆盖它，例：
#   PLOVE_DATABASE_URL=mysql+pymysql://用户:密码@主机:端口/库名?charset=utf8mb4
PLOVE_DATABASE_URL=
# 打印 SQL（排查问题时临时打开）
PLOVE_DATABASE_ECHO=false

# 心跳间隔（秒），由服务端下发给客户端
PLOVE_HEARTBEAT_INTERVAL_SECONDS=30

# 后台管理令牌。**留空 = 后台接口全部拒绝**（这是故意的：
# 忘配一个变量不该等于把后台裸奔）。用 X-Admin-Token 这个头带上它。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
PLOVE_ADMIN_TOKEN=

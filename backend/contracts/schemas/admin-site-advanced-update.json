{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/admin-site-advanced-update.json",
  "description": "修改单站高级设置请求。",
  "properties": {
    "custom_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "前台自定义别名",
      "title": "Custom Name"
    },
    "badge": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "前台站点角标",
      "title": "Badge"
    },
    "timeout_seconds": {
      "anyOf": [
        {
          "maximum": 120.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "超时秒数",
      "title": "Timeout Seconds"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "运维备注",
      "title": "Note"
    },
    "proxy_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "是否为该站点开启独立代理",
      "title": "Proxy Enabled"
    },
    "proxy_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "该站点使用的代理地址",
      "title": "Proxy Url"
    },
    "proxy_node_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "绑定的代理节点 ID",
      "title": "Proxy Node Id"
    }
  },
  "title": "SiteAdvancedSettingUpdateRequest",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/admin-site-advanced-update.json",
  "description": "修改单站高级设置请求。",
  "properties": {
    "custom_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "前台自定义别名",
      "title": "Custom Name"
    },
    "badge": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "前台站点角标",
      "title": "Badge"
    },
    "timeout_seconds": {
      "anyOf": [
        {
          "maximum": 120.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "超时秒数",
      "title": "Timeout Seconds"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "运维备注",
      "title": "Note"
    }
  },
  "title": "SiteAdvancedSettingUpdateRequest",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/catalog-list.json",
  "$defs": {
    "VodItem": {
      "description": "统一的影片卡片。\n\n必填四项是硬约定（见 crawler-plan.md 2.4）——缺了就该在爬虫那侧被丢掉，\n不允许\"凑合入库\"。\n\n源站可能带扩展字段，一律忽略而不是报错：扩展字段是给上游自己玩的，\n不进契约。",
      "properties": {
        "vod_id": {
          "description": "站内唯一且可复现；多线路时用完整路径，不要抠数字",
          "title": "Vod Id",
          "type": "string"
        },
        "vod_name": {
          "title": "Vod Name",
          "type": "string"
        },
        "vod_pic": {
          "title": "Vod Pic",
          "type": "string"
        },
        "vod_remarks": {
          "title": "Vod Remarks",
          "type": "string"
        },
        "vod_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Year"
        },
        "vod_area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Area"
        },
        "vod_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Type"
        },
        "vod_actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Actor"
        },
        "vod_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Score"
        }
      },
      "required": [
        "vod_id",
        "vod_name",
        "vod_pic",
        "vod_remarks"
      ],
      "title": "VodItem",
      "type": "object"
    }
  },
  "description": "分类与搜索共用。",
  "properties": {
    "videos": {
      "items": {
        "$ref": "#/$defs/VodItem"
      },
      "title": "Videos",
      "type": "array"
    },
    "page": {
      "default": 1,
      "title": "Page",
      "type": "integer"
    },
    "has_more": {
      "default": false,
      "title": "Has More",
      "type": "boolean"
    }
  },
  "title": "ListPayload",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/catalog-detail.json",
  "$defs": {
    "Episode": {
      "description": "单集。\n\n``ep_index`` 是 **1 起算的集号**，不是数组下标。\n\n``play_id`` 的含义由爬虫定义：后端拿到它去调 ``play``，自行不作解释。\n多线路源的集号会重复，必须靠 ``line`` 区分——所以 ``play_id`` 建议用完整路径\n（见 crawler-plan.md 的\"最容易踩的坑\"）。",
      "properties": {
        "ep_index": {
          "description": "1 起算的集号",
          "minimum": 1,
          "title": "Ep Index",
          "type": "integer"
        },
        "ep_name": {
          "default": "",
          "title": "Ep Name",
          "type": "string"
        },
        "play_id": {
          "title": "Play Id",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "多线路源才有；单线路为 null",
          "title": "Line"
        },
        "duration_sec": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Sec"
        }
      },
      "required": [
        "ep_index",
        "play_id"
      ],
      "title": "Episode",
      "type": "object"
    },
    "LineInfo": {
      "description": "一条播放线路。多线路源必须让上层知道有几条线、各有多少集。",
      "properties": {
        "line": {
          "description": "线路号，1 起算",
          "title": "Line",
          "type": "integer"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "line"
      ],
      "title": "LineInfo",
      "type": "object"
    },
    "VodItem": {
      "description": "统一的影片卡片。\n\n必填四项是硬约定（见 crawler-plan.md 2.4）——缺了就该在爬虫那侧被丢掉，\n不允许\"凑合入库\"。\n\n源站可能带扩展字段，一律忽略而不是报错：扩展字段是给上游自己玩的，\n不进契约。",
      "properties": {
        "vod_id": {
          "description": "站内唯一且可复现；多线路时用完整路径，不要抠数字",
          "title": "Vod Id",
          "type": "string"
        },
        "vod_name": {
          "title": "Vod Name",
          "type": "string"
        },
        "vod_pic": {
          "title": "Vod Pic",
          "type": "string"
        },
        "vod_remarks": {
          "title": "Vod Remarks",
          "type": "string"
        },
        "vod_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Year"
        },
        "vod_area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Area"
        },
        "vod_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Type"
        },
        "vod_actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Actor"
        },
        "vod_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vod Score"
        }
      },
      "required": [
        "vod_id",
        "vod_name",
        "vod_pic",
        "vod_remarks"
      ],
      "title": "VodItem",
      "type": "object"
    }
  },
  "properties": {
    "video": {
      "$ref": "#/$defs/VodItem"
    },
    "desc": {
      "default": "",
      "title": "Desc",
      "type": "string"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/Episode"
      },
      "title": "Episodes",
      "type": "array"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/LineInfo"
      },
      "title": "Lines",
      "type": "array"
    }
  },
  "required": [
    "video"
  ],
  "title": "DetailPayload",
  "type": "object"
}

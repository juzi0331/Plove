{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/health.json",
  "description": "健康检查。故意只回最少的字段：它要能在数据库、爬虫全挂时照样返回。",
  "properties": {
    "status": {
      "const": "ok",
      "default": "ok",
      "title": "Status",
      "type": "string"
    },
    "env": {
      "title": "Env",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "env",
    "version"
  ],
  "title": "HealthPayload",
  "type": "object"
}

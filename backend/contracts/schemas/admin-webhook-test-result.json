{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/admin-webhook-test-result.json",
  "properties": {
    "channel": {
      "title": "Channel",
      "type": "string"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "status_code": {
      "default": 0,
      "title": "Status Code",
      "type": "integer"
    },
    "duration_ms": {
      "default": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "channel",
    "ok"
  ],
  "title": "WebhookTestResult",
  "type": "object"
}

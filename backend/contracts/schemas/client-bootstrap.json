{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/client-bootstrap.json",
  "$defs": {
    "ActionPayload": {
      "description": "命名意图动作描述。由前端映射至受控处理函数，不执行动态代码。",
      "properties": {
        "type": {
          "description": "动作类型: open_home, open_category, open_detail, start_playback, select_episode, request_source_switch, redeem, acknowledge_notice",
          "title": "Type",
          "type": "string"
        },
        "content_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "影片或条目规范标识",
          "title": "Content Id"
        },
        "category_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "分类标识",
          "title": "Category Id"
        },
        "site_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "源站标识",
          "title": "Site Key"
        },
        "episode_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "剧集标识",
          "title": "Episode Id"
        },
        "notice_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "公告标识",
          "title": "Notice Id"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "安全目标路径",
          "title": "Url"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActionPayload",
      "type": "object"
    },
    "BrandConfig": {
      "description": "品牌与标识配置。",
      "properties": {
        "name": {
          "default": "Plove",
          "description": "站点或品牌展示名称",
          "title": "Name",
          "type": "string"
        },
        "logo_url": {
          "default": "",
          "description": "品牌 Logo 图标地址（空则显示文字）",
          "title": "Logo Url",
          "type": "string"
        }
      },
      "title": "BrandConfig",
      "type": "object"
    },
    "CardTokens": {
      "description": "海报卡片设计 Token。",
      "properties": {
        "aspect_ratio": {
          "default": "16:9",
          "description": "卡片海报比例 (16:9, 2:3, 3:4, 1:1)",
          "title": "Aspect Ratio",
          "type": "string"
        },
        "radius_px": {
          "default": 6,
          "description": "卡片圆角半径像素 (0-32)",
          "maximum": 32,
          "minimum": 0,
          "title": "Radius Px",
          "type": "integer"
        },
        "image_fit": {
          "default": "cover",
          "description": "图片填充模式: cover / contain",
          "title": "Image Fit",
          "type": "string"
        }
      },
      "title": "CardTokens",
      "type": "object"
    },
    "ColorTokens": {
      "description": "色彩设计 Token。",
      "properties": {
        "background": {
          "default": "#141414",
          "description": "页面主背景色",
          "title": "Background",
          "type": "string"
        },
        "surface": {
          "default": "#202020",
          "description": "卡片与容器表面背景色",
          "title": "Surface",
          "type": "string"
        },
        "primary": {
          "default": "#E50914",
          "description": "品牌主色调（按钮/高亮/进度条）",
          "title": "Primary",
          "type": "string"
        },
        "text": {
          "default": "#FFFFFF",
          "description": "主要文字颜色",
          "title": "Text",
          "type": "string"
        },
        "muted": {
          "default": "#B8B8B8",
          "description": "次要弱化文字颜色",
          "title": "Muted",
          "type": "string"
        },
        "border": {
          "default": "#2A2A2A",
          "description": "边框与分割线颜色",
          "title": "Border",
          "type": "string"
        },
        "danger": {
          "default": "#E50914",
          "description": "警告或危险颜色",
          "title": "Danger",
          "type": "string"
        }
      },
      "title": "ColorTokens",
      "type": "object"
    },
    "LayoutTokens": {
      "description": "页面布局与间距 Token。",
      "properties": {
        "max_width_px": {
          "default": 1440,
          "description": "页面最大宽度像素",
          "maximum": 2560,
          "minimum": 960,
          "title": "Max Width Px",
          "type": "integer"
        },
        "page_padding_px": {
          "default": 16,
          "description": "页面边缘内边距像素",
          "maximum": 64,
          "minimum": 0,
          "title": "Page Padding Px",
          "type": "integer"
        },
        "gap_px": {
          "default": 14,
          "description": "栅格与板块间距像素",
          "maximum": 48,
          "minimum": 0,
          "title": "Gap Px",
          "type": "integer"
        }
      },
      "title": "LayoutTokens",
      "type": "object"
    },
    "MotionTokens": {
      "description": "动态效果与过渡 Token。",
      "properties": {
        "preset": {
          "default": "subtle",
          "description": "动效预设: none / subtle / smooth",
          "title": "Preset",
          "type": "string"
        },
        "duration_ms": {
          "default": 200,
          "description": "交互过渡基础毫秒数",
          "maximum": 1000,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "title": "MotionTokens",
      "type": "object"
    },
    "NavigationItem": {
      "description": "前台导航条目。",
      "properties": {
        "id": {
          "description": "导航项 ID，如 'home', 'category'",
          "title": "Id",
          "type": "string"
        },
        "label_key": {
          "description": "多语言或文案配置键",
          "title": "Label Key",
          "type": "string"
        },
        "label": {
          "description": "默认显示文案",
          "title": "Label",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ActionPayload",
          "description": "点击跳转意图"
        }
      },
      "required": [
        "id",
        "label_key",
        "label",
        "action"
      ],
      "title": "NavigationItem",
      "type": "object"
    },
    "PlayerDefaults": {
      "description": "播放器客户端全局默认偏好。",
      "properties": {
        "auto_next": {
          "default": true,
          "description": "播放完毕后是否自动播放下一集",
          "title": "Auto Next",
          "type": "boolean"
        },
        "auto_next_delay_seconds": {
          "default": 5,
          "description": "连播倒计时秒数",
          "maximum": 30,
          "minimum": 1,
          "title": "Auto Next Delay Seconds",
          "type": "integer"
        },
        "default_rate": {
          "default": 1.0,
          "description": "默认播放倍速",
          "maximum": 3.0,
          "minimum": 0.5,
          "title": "Default Rate",
          "type": "number"
        },
        "allowed_rates": {
          "description": "可选播放倍速列表",
          "items": {
            "type": "number"
          },
          "title": "Allowed Rates",
          "type": "array"
        },
        "hud_hide_after_ms": {
          "default": 3500,
          "description": "播放控制栏自动淡出隐藏毫秒数",
          "maximum": 10000,
          "minimum": 1000,
          "title": "Hud Hide After Ms",
          "type": "integer"
        }
      },
      "title": "PlayerDefaults",
      "type": "object"
    },
    "ThemeConfig": {
      "description": "完整主题配置。",
      "properties": {
        "color": {
          "$ref": "#/$defs/ColorTokens",
          "description": "色彩方案"
        },
        "typography": {
          "$ref": "#/$defs/TypographyTokens",
          "description": "字体排版"
        },
        "layout": {
          "$ref": "#/$defs/LayoutTokens",
          "description": "布局间距"
        },
        "card": {
          "$ref": "#/$defs/CardTokens",
          "description": "卡片形态"
        },
        "motion": {
          "$ref": "#/$defs/MotionTokens",
          "description": "动效与交互"
        }
      },
      "title": "ThemeConfig",
      "type": "object"
    },
    "TypographyTokens": {
      "description": "排版设计 Token。",
      "properties": {
        "family": {
          "default": "system",
          "description": "字体族预设: system / inter / roboto",
          "title": "Family",
          "type": "string"
        },
        "body_px": {
          "default": 15,
          "description": "正文字号像素 (12-24)",
          "maximum": 24,
          "minimum": 12,
          "title": "Body Px",
          "type": "integer"
        },
        "title_px": {
          "default": 26,
          "description": "标题字号像素 (18-48)",
          "maximum": 48,
          "minimum": 18,
          "title": "Title Px",
          "type": "integer"
        }
      },
      "title": "TypographyTokens",
      "type": "object"
    }
  },
  "description": "客户端启动并展示所需的完整基础配置。匿名或已激活客户端均可获取。",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Schema 规范版本",
      "title": "Schema Version",
      "type": "string"
    },
    "release_id": {
      "description": "当前生效的发布版本 ID",
      "title": "Release Id",
      "type": "string"
    },
    "revision": {
      "description": "单调自增的配置修订版本号",
      "title": "Revision",
      "type": "integer"
    },
    "min_runtime_version": {
      "default": "1.0.0",
      "description": "要求的客户端最低运行时版本",
      "title": "Min Runtime Version",
      "type": "string"
    },
    "refresh_after_seconds": {
      "default": 30,
      "description": "活跃客户端条件版本查询间隔秒数",
      "title": "Refresh After Seconds",
      "type": "integer"
    },
    "offline_display_ttl_seconds": {
      "default": 86400,
      "description": "离线安全展示有效秒数",
      "title": "Offline Display Ttl Seconds",
      "type": "integer"
    },
    "brand": {
      "$ref": "#/$defs/BrandConfig",
      "description": "品牌标识"
    },
    "theme": {
      "$ref": "#/$defs/ThemeConfig",
      "description": "主题视觉 Token"
    },
    "text": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "可配置的全局文案映射表",
      "title": "Text",
      "type": "object"
    },
    "navigation": {
      "description": "前台主导航配置",
      "items": {
        "$ref": "#/$defs/NavigationItem"
      },
      "title": "Navigation",
      "type": "array"
    },
    "page_references": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "命名路由到页面配置的映射关系",
      "title": "Page References",
      "type": "object"
    },
    "player_defaults": {
      "$ref": "#/$defs/PlayerDefaults",
      "description": "播放器全局呈现参数"
    }
  },
  "required": [
    "release_id",
    "revision"
  ],
  "title": "ClientBootstrapPayload",
  "type": "object"
}

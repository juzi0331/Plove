{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/system-status.json",
  "$defs": {
    "SystemNoticePayload": {
      "description": "全站公告内容与弹窗策略。",
      "properties": {
        "enabled": {
          "default": false,
          "description": "是否发布并生效",
          "title": "Enabled",
          "type": "boolean"
        },
        "title": {
          "default": "",
          "description": "公告标题",
          "title": "Title",
          "type": "string"
        },
        "content": {
          "default": "",
          "description": "公告详细正文",
          "title": "Content",
          "type": "string"
        },
        "level": {
          "default": "info",
          "description": "展示等级：info 提示, warning 警告, danger 紧急",
          "enum": [
            "info",
            "warning",
            "danger"
          ],
          "title": "Level",
          "type": "string"
        },
        "display_type": {
          "default": "banner",
          "description": "展示形式：banner 顶部跑马灯, modal 大厅强弹窗, header_bar 顶部常驻横幅, float 右下角悬浮卡片, both 弹窗+跑马灯, all 全渠道广播",
          "enum": [
            "banner",
            "modal",
            "both",
            "float",
            "header_bar",
            "all"
          ],
          "title": "Display Type",
          "type": "string"
        },
        "action_text": {
          "default": "",
          "description": "操作按钮文案（如：查看详情/立即加群，选填）",
          "title": "Action Text",
          "type": "string"
        },
        "action_url": {
          "default": "",
          "description": "操作跳转链接（如：官网/群链接，选填）",
          "title": "Action Url",
          "type": "string"
        },
        "dismissible": {
          "default": true,
          "description": "用户是否可手动点击关闭",
          "title": "Dismissible",
          "type": "boolean"
        },
        "updated_at": {
          "default": "",
          "description": "最后更新时间",
          "title": "Updated At",
          "type": "string"
        }
      },
      "title": "SystemNoticePayload",
      "type": "object"
    }
  },
  "description": "公共系统状态（客户端 App / Web 启动时调用的公开接口）。",
  "properties": {
    "maintenance": {
      "default": false,
      "description": "当前是否处于全站维护中",
      "title": "Maintenance",
      "type": "boolean"
    },
    "maintenance_message": {
      "default": "",
      "description": "维护文案",
      "title": "Maintenance Message",
      "type": "string"
    },
    "notice": {
      "anyOf": [
        {
          "$ref": "#/$defs/SystemNoticePayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "当前生效的公告信息"
    },
    "image_proxy_enabled": {
      "default": false,
      "description": "是否全局开启图片防盗链代理",
      "title": "Image Proxy Enabled",
      "type": "boolean"
    },
    "image_decrypt_domains": {
      "description": "需要中继解密的图床域名特征列表",
      "items": {
        "type": "string"
      },
      "title": "Image Decrypt Domains",
      "type": "array"
    }
  },
  "title": "SystemStatusPayload",
  "type": "object"
}

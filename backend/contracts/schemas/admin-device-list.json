{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/admin-device-list.json",
  "$defs": {
    "DeviceItem": {
      "description": "一台设备。**没有 token 字段，只有掩码前缀**（见文件头）。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "token_prefix": {
          "description": "令牌前 6 位，只为让后台能区分是哪一台",
          "title": "Token Prefix",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "last_seen_at": {
          "description": "最后一次心跳/请求时间",
          "format": "date-time",
          "title": "Last Seen At",
          "type": "string"
        },
        "is_active": {
          "description": "它是不是当前占着活跃位的那台",
          "title": "Is Active",
          "type": "boolean"
        },
        "is_playing": {
          "default": false,
          "description": "当前是否正在播放影片",
          "title": "Is Playing",
          "type": "boolean"
        },
        "current_vod_title": {
          "default": "",
          "description": "当前正在观看的剧名与集数",
          "title": "Current Vod Title",
          "type": "string"
        },
        "last_playback_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "最后播放上报时间",
          "title": "Last Playback At"
        }
      },
      "required": [
        "id",
        "token_prefix",
        "created_at",
        "last_seen_at",
        "is_active"
      ],
      "title": "DeviceItem",
      "type": "object"
    }
  },
  "description": "某个码用过的所有设备。",
  "properties": {
    "devices": {
      "items": {
        "$ref": "#/$defs/DeviceItem"
      },
      "title": "Devices",
      "type": "array"
    },
    "active_device_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Device Id"
    }
  },
  "title": "DeviceListPayload",
  "type": "object"
}

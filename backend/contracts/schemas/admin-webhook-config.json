{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plove.local/schemas/admin-webhook-config.json",
  "$defs": {
    "EventSubscriptions": {
      "properties": {
        "circuit_break": {
          "default": true,
          "description": "内容源连续失败或熔断告警",
          "title": "Circuit Break",
          "type": "boolean"
        },
        "circuit_recover": {
          "default": true,
          "description": "内容源自愈恢复通知",
          "title": "Circuit Recover",
          "type": "boolean"
        },
        "site_health_report": {
          "default": true,
          "description": "聚合内容源清单与连通性自检报告",
          "title": "Site Health Report",
          "type": "boolean"
        },
        "code_activated": {
          "default": true,
          "description": "新激活码首次绑定激活通知",
          "title": "Code Activated",
          "type": "boolean"
        },
        "device_conflict": {
          "default": true,
          "description": "同码多设备抢线/冲突下线告警",
          "title": "Device Conflict",
          "type": "boolean"
        },
        "security_alert": {
          "default": true,
          "description": "接口防刷与高频限流安全告警",
          "title": "Security Alert",
          "type": "boolean"
        },
        "proxy_offline": {
          "default": true,
          "description": "代理节点异常或高延迟报警",
          "title": "Proxy Offline",
          "type": "boolean"
        },
        "daily_report": {
          "default": false,
          "description": "每日系统流量与设备简报",
          "title": "Daily Report",
          "type": "boolean"
        },
        "system_startup": {
          "default": false,
          "description": "Plove 服务集群启动/重启就绪通知",
          "title": "System Startup",
          "type": "boolean"
        },
        "fail_threshold": {
          "default": 3,
          "description": "连续失败触发告警的阈值次数",
          "maximum": 10,
          "minimum": 1,
          "title": "Fail Threshold",
          "type": "integer"
        }
      },
      "title": "EventSubscriptions",
      "type": "object"
    },
    "TelegramConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "bot_token": {
          "default": "",
          "description": "Telegram Bot Token，如 123456:ABC-DEF",
          "title": "Bot Token",
          "type": "string"
        },
        "chat_id": {
          "default": "",
          "description": "接收消息的 Chat ID / Group ID",
          "title": "Chat Id",
          "type": "string"
        },
        "proxy_url": {
          "default": "",
          "description": "可选的 HTTP/SOCKS5 代理地址，如 http://127.0.0.1:10809",
          "title": "Proxy Url",
          "type": "string"
        },
        "bot_username": {
          "default": "",
          "description": "自动识别的 Bot @username",
          "title": "Bot Username",
          "type": "string"
        },
        "bot_name": {
          "default": "",
          "description": "自动识别的 Bot 名称",
          "title": "Bot Name",
          "type": "string"
        },
        "console_url": {
          "default": "",
          "description": "管理后台公网或局域网访问地址（用于推送通知内快捷直达按钮）",
          "title": "Console Url",
          "type": "string"
        }
      },
      "title": "TelegramConfig",
      "type": "object"
    }
  },
  "properties": {
    "telegram": {
      "$ref": "#/$defs/TelegramConfig"
    },
    "events": {
      "$ref": "#/$defs/EventSubscriptions"
    },
    "wechat_work": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wechat Work"
    },
    "feishu": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feishu"
    },
    "custom_http": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Custom Http"
    }
  },
  "title": "WebhookConfigPayload",
  "type": "object"
}

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# 环境变量文件：
#   .env        —— 本地开发（含数据库密码、后台令牌）
#   .env.prod   —— 生产（同上，而且是在服务器上）
#   例外：*.example 那些是模板，要进仓库
.env
.env.*
!*.example

# 前端
node_modules/
dist/

# 本地数据与缓存（数据库文件与图片代理缓存不进仓库）
*.db
*.sqlite3
backend/data/
backend/data/img_cache/
**/img_cache/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本地调试与逆向抓包临时文件
.freebuff/

# Docker 容器化配置（私有部署配置，不同步）
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
docker/

# 压缩包文件（打包产物）
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
make_clean_zip.py

# 部署教程文档（保密与私有配置说明）
*教程*.md
*部署*.md
宝塔面板*.md

# 采集器适配器脚本（动态采集脚本，不同步至远程仓库，保持仓库清空纯净）
crawler/sites/*
!crawler/sites/__init__.py
!crawler/sites/.gitkeep


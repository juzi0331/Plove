# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
*.egg-info/
coverage/

# 环境变量文件 (保留所有 *.example 模板)
.env
.env.*
!*.example

# 前端构建产物与依赖
node_modules/
dist/
.vite/
.next/

# 本地数据与缓存
*.db
*.sqlite
*.sqlite3
*.log
backend/data/*
!backend/data/.gitkeep
**/img_cache/
*webhook_config.json

# 编辑器与操作系统痕迹
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
.freebuff/

# Docker 容器化配置与脚本
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
docker/

# 压缩包与打包生成脚本 (禁止上传任何归档与打包 Python)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*zip*.py
*package*.py
build_*.py
make_clean_zip.py

# 外部预编译内核及二进制执行文件 (不进 git，代码支持自动在线下载安装)
backend/bin/

# 各种没必要的文档 (文档只上传 README.md)
docs/
*.md
!README.md
!**/README.md

# 采集器适配器脚本（动态采集脚本，不同步至远程仓库，保持仓库清空纯净）
crawler/sites/*
!crawler/sites/__init__.py
!crawler/sites/.gitkeep
